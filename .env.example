# Copy to .env.local. The app runs with only the first block set.

# --- Required for local dev ---
DATABASE_URL=postgres://becreative:becreative@localhost:5432/becreative
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BeCreative

# Email verification is on. In local dev, messages land in the email outbox.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=console
EMAIL_FROM=BeCreative <hello@becreative.local>

# --- Maps (no key required) ---
NEXT_PUBLIC_MAP_PROVIDER=leaflet
GEOCODER_PROVIDER=local
# GEOCODER_PROVIDER=nominatim
# GEOCODER_PROVIDER=mapbox
# MAPBOX_TOKEN=

# --- Media ---
# local writes to ./data/uploads and serves them from /api/media
# s3 uses the AWS SDK. Point S3_ENDPOINT at MinIO for a local bucket.
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
# STORAGE_PROVIDER=s3
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=becreative-media
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL_BASE=

# --- Email via Amazon SES (used only when EMAIL_PROVIDER=ses) ---
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=hello@yourdomain.com

# --- Stripe (optional). Leave blank and the demo still books as pay-at-studio. ---
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee percent and fixed amount live in the platform_settings table, not here.
