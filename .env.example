# Copy to .env.local. The app runs with only the first block set.
# Production names are AUTH_SECRET and APP_URL. The BETTER_AUTH_* and NEXT_PUBLIC_APP_URL
# names still work and are what local dev and CI set.

# --- Required for local dev ---
DATABASE_URL=postgres://becreative:becreative@localhost:5432/becreative
AUTH_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BeCreative

# Comma-separated. These addresses are granted the admin role on sign-up, sign-in, and seed.
# Seed creates a missing account with no password. Set one with Forgot password or Google.
ADMIN_EMAILS=eric.leino@gmail.com

# Email verification is on. In local dev, messages land in the email outbox.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=console
EMAIL_FROM=BeCreative <hello@becreative.local>

# --- Maps (no key required) ---
NEXT_PUBLIC_MAP_PROVIDER=leaflet
GEOCODER_PROVIDER=local
# GEOCODER_PROVIDER=nominatim
# GEOCODER_PROVIDER=mapbox
# MAPBOX_TOKEN=

# --- Media ---
# local writes to ./data/uploads and serves them from /api/media
# s3 uses the AWS SDK default credential chain. On App Runner, leave the access keys unset
# and attach an instance role that can s3:PutObject and s3:GetObject. Set the keys only for MinIO or a local IAM user.
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
# STORAGE_PROVIDER=s3
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=becreative-media
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL_BASE=

# --- Email via Amazon SES (used only when EMAIL_PROVIDER=ses) ---
# The SES client also uses the instance role when the access keys are unset.
# AWS_REGION=us-west-2
# SES_FROM_EMAIL=hello@yourdomain.com

# --- Google sign-in (optional). Hidden until both values are set. ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- RDS ---
# DATABASE_SSL=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# TRUSTED_PROXY_CIDRS=

# Minutes an unpaid Stripe Checkout keeps a seat. Default is 30.
# CHECKOUT_HOLD_MINUTES=30

# --- Feedback fix loop (optional) ---
# When an admin approves a note, or an admin submits one, the app POSTs
# event "feedback.approved" to this URL. The body is JSON. Header
# X-Feedback-Signature is sha256=<hmac-sha256 of the raw body> using the secret.
# Authorization is Bearer <FEEDBACK_WEBHOOK_KEY>. If the URL is unset, the
# attempt is stored as undelivered and the user's submit still succeeds.
# FEEDBACK_WEBHOOK_URL=
# FEEDBACK_WEBHOOK_SECRET=
# FEEDBACK_WEBHOOK_KEY=
# Bearer token for POST /api/feedback/:id/status and GET /api/feedback/queue.
# Leave unset and those routes stay closed.
# FEEDBACK_CALLBACK_TOKEN=

# --- Stripe (optional). Leave blank and the demo still books as pay-at-studio. ---
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee percent and fixed amount live in the platform_settings table, not here.
